<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Membaca kontak untuk menemukan entri "panggilan suara WhatsApp" -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- WhatsApp menolak permintaan panggilan dari app yang tidak punya izin Telepon -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Izin Telepon tidak mewajibkan HP punya kartu SIM -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <!-- Menampilkan tombol telepon sebagai notifikasi di layar kunci (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Memunculkan lagi notifikasi setelah HP restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Supaya app bisa melihat WhatsApp terpasang (Android 11+) -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- Layar pengaturan -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Layar tak terlihat yang bisa tampil di atas layar kunci lalu memulai panggilan WA -->
        <activity
            android:name=".CallActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:turnScreenOn="true" />

        <!-- Memunculkan lagi notifikasi setelah restart, update app, atau saat notifikasi diusap -->
        <receiver
            android:name=".RepostReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Tombol di panel cepat (Quick Settings) -->
        <service
            android:name=".CallTileService"
            android:exported="true"
            android:icon="@drawable/ic_call"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
